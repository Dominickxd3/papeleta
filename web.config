<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <rewrite>
      <rules>
        <!-- API y archivos subidos al backend Node cuando la app se publica en raiz -->
        <rule name="ReverseProxy Root ApiUploads" stopProcessing="true">
          <match url="^(api/.*|uploads/.*)$" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>

        <!-- Estaticos bajo subruta servidos directo por IIS (compatibilidad) -->
        <rule name="Serve Static Under Subpath" stopProcessing="true">
          <match url="^SistemasPapeletas/(css/.*|js/.*|img/.*|icons/.*|lib/.*|uploads/.*|HTML/.*|manifest\.webmanifest|robots\.txt|sitemap\.xml|favicon\.ico)$" />
          <action type="Rewrite" url="{R:1}" />
        </rule>

        <!-- Reverse proxy al backend Node bajo subruta (compatibilidad) -->
        <rule name="ReverseProxy SistemasPapeletas" stopProcessing="true">
          <match url="^SistemasPapeletas/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/SistemasPapeletas/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Si usas carga de archivos grande -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>

